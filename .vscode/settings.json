{
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.formatOnSave": true,
  "files.eol": "\n",
  "files.encoding": "utf8",
  "files.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/*.log": true,
    "**/*.asar": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/*.asar": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/*.asar": true,
    "**/package-lock.json": true
  }
}
